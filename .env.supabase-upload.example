# Copy this file to `.env.supabase-upload` and fill in real values.
# `.env.supabase-upload` is ignored by git.

SUPABASE_ACCESS_TOKEN=

# Optional. If set, the setup script can apply Supabase migrations.
# Otherwise, run the migration SQL manually in the Supabase SQL Editor.
SUPABASE_DB_PASSWORD=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_B64=

# Optional. The function can discover this automatically.
GITHUB_INSTALLATION_ID=

GITHUB_OWNER=RSDWArchive
GITHUB_REPO=RSDWBuilds
GITHUB_BRANCH=main
GITHUB_WORKFLOW_ID=process-submissions.yml
DEPLOY_WORKFLOW_ID=deploy-pages.yml
REPLACE_WORKFLOW_ID=replace-entry.yml
SITE_ASSETS_WORKFLOW_ID=sync-site-assets.yml
UPLOAD_ALLOWED_ORIGINS=https://rsdwbuilds.com,http://localhost:8000,http://127.0.0.1:8000
MAX_ZIP_BYTES=26214400
MAX_IMAGE_BYTES=8388608
